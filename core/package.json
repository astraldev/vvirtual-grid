{
  "name": "vvirtual-grid",
  "version": "1.0.0-alpha.0",
  "keywords": [
    "grid",
    "virtual scroll",
    "vue",
    "windowing"
  ],
  "bugs": {
    "url": "https://github.com/astraldev/vvirtual-grid/issues"
  },
  "license": "MIT",
  "author": "Roc Wong <roc@kiwiberry.nz>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astraldev/vvirtual-grid.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./vue": {
      "types": "./integrations/vue/index.ts",
      "import": "./integrations/vue/index.ts"
    },
    "./nuxt": {
      "types": "./integrations/nuxt/module.ts",
      "import": "./integrations/nuxt/module.ts"
    }
  },
  "scripts": {
    "build": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "ramda": "^0.32.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nuxt/kit": "^3.17.0",
    "@types/ramda": "^0.31.1",
    "happy-dom": "^17.1.0",
    "lodash-es": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:"
  }
}
